{
  "name": "hubble-web",
  "version": "2.11.0",
  "private": true,
  "homepage": "/spatial-viewer",
  "baseURL": "/spatial-viewer",
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@devexpress/dx-react-core": "4.0.11",
    "@devexpress/dx-react-grid": "4.0.11",
    "@devexpress/dx-react-grid-bootstrap4": "4.0.11",
    "@elastic/react-search-ui": "1.24.2",
    "@elastic/search-ui-app-search-connector": "1.24.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@hms-dbmi/viv": "0.22.1",
    "antd": "6.6.1",
    "autoprefixer": "10.5.4",
    "axios": "1.19.0",
    "bootstrap": "5.3.8",
    "bootstrap-5-css-only": "5.1.3",
    "history": "5.3.0",
    "immutability-helper": "3.1.1",
    "isomorphic-unfetch": "4.0.2",
    "kpmp-common-components": "file:./kpmp-common-components-1.3.0.tgz",
    "kpmp-common-styles": "1.0.13",
    "mathjs": "15.2.0",
    "react": "^19.2.8",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-ga4": "3.0.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "7.18.2",
    "reactstrap": "9.2.3",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "vitessce": "4.0.4"
  },
  "overrides": {
    "autoprefixer": "10.5.4",
    "react-scripts": {
      "@svgr/webpack": "6.0.0"
    },
    "material-ui": "4.1.1",
    "fast-xml-parser": "4.2.5",
    "semver": "7.5.2",
    "jest": "27.0.0",
    "webpack": "5.97.1",
    "ws": "8.18.0",
    "d3-color": "3.1.0"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--max_old_space_size=8192 npm run start-js",
    "build": "npm-run-all build-css build-js",
    "test": "react-scripts test --transformIgnorePatterns 'node_modules/(?!vitessce|@devexpress|@elastic|react-ga4|@hms-dbmi|@deck.gl|@vivjs)'",
    "eject": "react-scripts eject",
    "start-js": "NODE_OPTIONS=--max_old_space_size=8192 craco start",
    "build-js": "craco --max_old_space_size=8192 build",
    "build-css": "sass -I ./src -I ./node_modules  src/:src/",
    "watch-css": "yarn build-css && sass -I ./src -I ./node_modules src/:src/ --watch",
    "analyze": "REACT_APP_RUN_ANALYZER=true npm run build"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@ui5|lit-html)).*\\.js$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@craco/craco": "7.1.0",
    "craco-alias": "3.0.1",
    "graphql": "17.0.2",
    "npm-run-all": "4.1.5",
    "react-scripts": "5.0.1",
    "sass": "1.103.1",
    "webpack-bundle-analyzer": "5.3.2"
  }
}
